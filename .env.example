# Set a strong unique password; never expose this unauthenticated over the Internet.
MUJOCO_CONSOLE_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
CONSOLE_PORT=8000
MAX_VIEWERS=3
INSTALL_ROBOTICS=1
MUJOCO_GL=osmesa
PYOPENGL_PLATFORM=osmesa
COOKIE_SECURE=0
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
SESSION_IDLE_SECONDS=900

# Viewer rendering. Rendering only runs while a browser is subscribed to the MJPEG stream;
# these control frame rate, render size and how many CPU threads a viewer may use.
VIEWER_FPS=12
VIEWER_WIDTH=640
VIEWER_HEIGHT=480
# llvmpipe (OSMesa software rasteriser) worker threads per viewer process. The default pool
# has one thread per core and oversubscribes: on a 12-thread host 1 viewer cost ~520% CPU,
# 2 threads cost ~170% at a *higher* frame rate, and 3 concurrent viewers cost 430% instead
# of 645%. Raise this for very heavy scenes or large render sizes. Range 1-64.
VIEWER_RENDER_THREADS=2
# BLAS/OpenMP threads inside a viewer process; rendering needs none of them. Range 1-64.
VIEWER_BLAS_THREADS=1

# Optional container caps (leave commented out or 0 for unlimited). Recommended when the
# console shares the host with other services: CONSOLE_CPU_LIMIT=10, CONSOLE_MEM_LIMIT=8g
#CONSOLE_CPU_LIMIT=0
#CONSOLE_MEM_LIMIT=0
