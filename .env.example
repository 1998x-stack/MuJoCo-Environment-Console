# Set a strong unique password; never expose this unauthenticated over the Internet.
MUJOCO_CONSOLE_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
CONSOLE_PORT=8000
MAX_VIEWERS=3
INSTALL_ROBOTICS=1
MUJOCO_GL=osmesa
PYOPENGL_PLATFORM=osmesa
COOKIE_SECURE=0
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
SESSION_IDLE_SECONDS=900
