<mujoco model="double pendulum tracking">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <visual><global offwidth="640" offheight="480"/></visual>
  <include file="links.xml"/>
  <worldbody>
    <light pos="0 -3 4" dir="0 0 -1" diffuse="0.85 0.85 0.85"/>
    <camera name="overview" pos="2.2 -3.2 1.5" xyaxes="0.82 0.57 0 -0.24 0.35 0.90"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.12 0.17 0.25 1"/>
  </worldbody>
  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="8" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="elbow_motor" joint="elbow" gear="4" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
